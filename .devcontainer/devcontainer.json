{
	"name": "Ubuntu",
	"build": { "dockerfile": "Dockerfile" },

  // Store Claude's persistent state on the host
  "mounts": [
    "source=${localEnv:HOME}/.claude-devcontainer,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=elan-shared,target=/home/vscode/.elan,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "safe.directory",
    "GIT_CONFIG_VALUE_0": "${containerWorkspaceFolder}",
    "PGHOST": "host.docker.internal"
  },

	"customizations": {
		"vscode": {
			"extensions": ["leanprover.lean4", "anthropic.claude-code"]
		}
	}
}
